NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
OPENAI_API_KEY=
# Optional: verify current cheap-tier model IDs at https://platform.openai.com/docs/models
OPENAI_MODEL=
SERPAPI_API_KEY=
SERPER_API_KEY=
SEARCH_PROVIDER=mock
# Optional: enables LinkedIn profile enrichment between SerpApi discovery and
# OpenAI matching. Leave both blank to skip enrichment entirely (SerpApi-only
# data flows straight to OpenAI, as before). If you set one, set both.
APIFY_API_TOKEN=
# Apify actor id, using "~" (not "/") as the owner/name separator, e.g.
# harvestapi/linkedin-profile-scraper -> harvestapi~linkedin-profile-scraper
APIFY_ACTOR_ID=harvestapi~linkedin-profile-scraper
